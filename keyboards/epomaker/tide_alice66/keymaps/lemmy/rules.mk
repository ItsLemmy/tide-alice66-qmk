# Preserve wireless transport while bypassing vendor RGB-recording behavior.
TIDE_ALICE66_CLEAN_WIRELESS = yes
# Keep simultaneous typing from sharing one global debounce timer.
DEBOUNCE_TYPE = sym_defer_pk
VIA_ENABLE = yes
DYNAMIC_KEYMAP_ENABLE = yes
# Expose the physical encoder through VIA's dynamic encoder protocol.
ENCODER_MAP_ENABLE = yes
